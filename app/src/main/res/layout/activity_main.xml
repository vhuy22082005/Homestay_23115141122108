<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- THÔNG TIN THÍ SINH -->
        <TextView
            android:id="@+id/thongtin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nguyễn Doãn Vinh Huy - 23115141122108"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <!-- TRƯỜNG 1: TÊN -->
        <TextView
            android:id="@+id/tvTen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tên khách hàng"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/edtTen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nhập tên khách hàng"
            android:textColor="#000000"
            android:textColorHint="#757575"
            android:inputType="textPersonName"
            android:layout_marginBottom="12dp" />

        <!-- TRƯỜNG 2: SỐ LƯỢNG -->
        <TextView
            android:id="@+id/tvSoLuong"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Số đêm"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/edtSoLuong"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nhập số đêm cư trú"
            android:textColor="#000000"
            android:textColorHint="#757575"
            android:inputType="number"
            android:layout_marginBottom="12dp" />

        <!-- TRƯỜNG 3: ĐƠN GIÁ -->
        <TextView
            android:id="@+id/tvDonGia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Giá phòng"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/edtDonGia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nhập giá phòng 1 đêm"
            android:textColor="#000000"
            android:textColorHint="#757575"
            android:inputType="numberDecimal"
            android:layout_marginBottom="16dp" />

        <!-- 3 NÚT BẤM -->
        <Button
            android:id="@+id/btnLuu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lưu"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnThongKe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Thống kê"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnXoa_2108"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="3. Xóa trắng form"
            android:layout_marginBottom="16dp" />

        <!-- KẾT QUẢ VÀ THỐNG KÊ -->
        <TextView
            android:id="@+id/tvKetQua"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textColor="#2E7D32"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvThongKe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="#1565C0"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>